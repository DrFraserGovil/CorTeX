#Auto-generated by the projectmake utility
BUILD_DIR = .build

.PHONY: all ship purge clean mirror test

MIRROR_FLAGS ?= -vf
MAKEFLAGS += --no-print-directory

all:
	@$(MAKE) mirror MIRROR_FLAGS=-fq
	@if [ ! -d "$(BUILD_DIR)" ]; then \
		mkdir -p $(BUILD_DIR); \
		cmake -S . -B $(BUILD_DIR) -DCMAKE_BUILD_TYPE=Release -DFORCE_JSL_CLONE=OFF; \
	fi
	@cmake --build $(BUILD_DIR)  --config Release --target cortex $(EXTRA_BUILD_FLAGS)
# the end-to-end tests need xelatex and dvisvgm (they're skipped without them); TEST_FLAGS picks tests, e.g. TEST_FLAGS="[syntax]"
test: all
	@cmake -S . -B $(BUILD_DIR) -DCORTEX_TESTS=ON > /dev/null
	@cmake --build $(BUILD_DIR) --config Release --target cortex_tests $(EXTRA_BUILD_FLAGS)
	@$(BUILD_DIR)/cortex_tests $(TEST_FLAGS)
mirror:
	@command -v lsj>/dev/null 2>&1 && lsj src/Settings/*.h $(MIRROR_FLAGS) || echo "no mirror found, using cached values" 
ship:
	@$(MAKE) mirror
	@mkdir -p $(BUILD_DIR)
	@cmake -S . -B $(BUILD_DIR) -DFORCE_JSL_CLONE=ON -DCMAKE_BUILD_TYPE=Release
	@cmake --build $(BUILD_DIR) --config Release --target cortex -- --no-print-directory

# 3. Clean up only the build artifacts
purge:
	@echo "Removing all build files"
	@rm -rf $(BUILD_DIR)
	@rm -f cortex

clean:
	@echo "Rebuilding from scratch"
	@$(MAKE) purge
	@$(MAKE) all 
