SettingsObject
{
    Categories
    {
        System
        {
            Members
            {
                int PollingDelay
                {
                    trigger="delay"
                    default=10
                    note="The delay time between polls (in ms)"
                }
                bool Verbose
                {
                    trigger="v"
                    default=false
                    note="Inlcudes debugging error messages. Overrides quiet"
                }
                bool Quiet
                {
                    trigger="q"
                    default=false
                    note="Suppresses all outputs except errors."
                }
                std::string TerminationFileName
                {
                    trigger="terminate"
                    default="foamtex_disable_message"
                    note="If a file with this name appears in a watched directory, foamtex will take this as a signal to exit. The file is deleted."
                }
                
                bool ForceCreate
                {
                    trigger="f"
                    default=false
                    note="If true, automatically creates a foamtex index in the current directory"
                }
            }        
        }
        Files
        {
            Members
            {
                std::string TargetDirectory
                {
                    default="."
                    trigger="i"
                    note="The target directory to launch the foamtex process in. If no argument is provided, activates in the current working directory."
                }
                std::string OutputDirectory
                {
                    default="compiled"
                    trigger="directory"
                    note="The name of the output directory which will contain the compiled pdfs"
                }

                std::vector<std::string> WatchedPatterns
                {
                    default={"*.tex","*.dat"}
                    trigger="watch"
                    note="The file patterns included in the indexing process"
                }
                std::vector<std::string> IgnoredPatterns
                {
                    default={"*.git*","*.build*","*/libs*"}
                    trigger="ignore"
                    note="Directory name patterns which are not watched for new files"
                }
            }
        }
    }
}
