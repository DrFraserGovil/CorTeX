SettingsObject
{
	Categories
	{
		System
		{
			Members
			{ 
				int DispatchDelay
				{
					trigger="delay"
					default=10
					note="The delay time (in ms) between detecting a filechange and dispatching the calls to the manager."
				}
				bool Verbose
				{
					trigger="v"
					default=false
					note="Inlcudes debugging error messages. Overrides quiet"
				}
				bool VeryVerbose
				{
					trigger="vv"
					default=false
					note="Adds additional context to debugging error messages."
				}
				bool Quiet
				{
					trigger="q"
					default=false
					note="Suppresses all outputs except errors."
				}
				std::string TerminationFileName
				{
					trigger="terminate"
					default="cortex_disable_message"
					note="If a file with this name appears in a watched directory, cortex will take this as a signal to exit. The file is deleted."
				}
				size_t PollingDelay
				{
					trigger="poll-delay"
					default = 100
					note="The responsiveness delay (in ms) in the menu polling interface"
				}
				bool Pause
				{
					trigger="pause"
					default=false
					note="If true, disables calls to the compiler"
				}
	
			}
			Categories
			{
				Headless
				{
					Members
					{
						 bool Active
						{
							trigger="headless"
							default=false
							note="If true, runs the system in headless mode"
						}
						std::string CortexName
						{
							default="My Project"
							trigger = "headless-name"
							note = "The default name given to a new cortex instantiation if not provided by the user"
						}
						std::string AuthorName
						{
							default="Me"
							trigger = "headless-author"
							note = "The default author assigned to a new cortex instantiation if not provided by the user"
						}
						int RecursionLimit
						{
							default = 10
							trigger = "headless-recursion"
							note="The number of times a signal will be sent before determining the process is dead and unresponsive"
						}
						int RecursionDelay
						{
							default = 100
							trigger = "headless-delay"
							note="The time (in ms) between each recursive signal to a headless service"
						}
					}
				}
			}    
		}
		Files
		{
			Members
			{
				std::string TargetDirectory
				{
					default="."
					trigger="i"
					note="The target directory to launch the cortex process in. If no argument is provided, activates in the current working directory."
				}
				std::string OutputDirectory
				{
					default="compiled"
					trigger="directory"
					note="The name of the output directory which will contain the compiled pdf"
				}
				std::string BuildDirectory
				{
					default=".cortex/build"
					trigger="build"
					note="The name of the directory into which the autogenerated tex will be placed"
				}
				std::vector<std::string> WatchedPatterns
				{
					default={"*.tex","*.dat"}
					trigger="watch"
					note="The file patterns included in the indexing process"
				}
				std::vector<std::string> IgnoredPatterns
				{
					default={"*.git*","*.build*","*.cortex","*sentinel*"}
					trigger="ignore"
					note="Directory name patterns which are not watched for new files"
				}
				size_t StructureDelimiterRepeatCount
				{
					default=3
					trigger=delimiter-repeat
					note="The number of sequential, identical characters required to indicate that a line is a structural delimiter for note metadat"
				}
			}
		}
		Compiler
		{
			Members
			{
				
				std::vector<std::string> Packages
				{
					default={"xcolor","amssymb","amsmath","lmodern","hyperref"}
					trigger="package"
					note="Latex packages which are included in the global shared preamble"
				}    
				std::string CompilerCommand
				{
					default="pdflatex"
					trigger="compiler"
					note="The latex compiler used to generate files. Valid choices are 'pdflatex', 'xelatex', and 'lualatex'"
				}
			}
		}
		Document
		{
			Members
			{
				size_t Width
				{
					default=10
					trigger="width"
					note="The width of each standalone document (measured in cm)"
				}
				size_t TitleSize
				{
					default=18
					trigger="title-size"
					note="The font size (in pt) of the title text of the documents"
				}   
				bool TitleCentered
				{
					default=false
					trigger="title-center"
					note="If true, the title of all notes are centered on the page"
				}
				
				size_t FontSize
				{
					default=10
					trigger="text-size"
					note="The font size (in pt) of the body text of the documents"
				}   
				         
			}   
		}
	}
}
